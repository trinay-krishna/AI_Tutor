# Copy this file to .env and fill in the values.

# --- OpenAI ---
OPENAI_API_KEY=sk-...
# Update these to whichever current OpenAI models you have access to.
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_tutor
# Host is "db" inside Docker Compose; use "localhost" when running the backend directly.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ai_tutor

# --- Auth / sessions ---
SESSION_TTL_DAYS=30
COOKIE_SECURE=false

# --- RAG ---
RAG_MIN_SIMILARITY=0.35

# --- LangSmith tracing (optional; sends prompts/content to LangSmith when enabled) ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
